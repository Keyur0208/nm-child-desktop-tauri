{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default capability for Nilkanth Medico HOMS Child application",
    "windows": ["*", "main"],
    "webviews": ["*", "main"],
    "remote": {
        "urls": [
            "http://*/*",
            "http://*:*/*",
            "http://*",
            "http://*:*",
            "https://*/*",
            "https://*:*/*",
            "https://*",
            "https://*:*",
            "https://*.nilkanthmedico.in",
            "https://*.nilkanthmedico.in/*",
            "https://nilkanthmedico.in",
            "https://nilkanthmedico.in/*",
            "https://*.nilkanthmedico.com",
            "https://*.nilkanthmedico.com/*",
            "https://nilkanthmedico.com",
            "https://nilkanthmedico.com/*",
            "http://192.168.*.*:*",
            "http://192.168.*.*:*/*",
            "http://192.168.*.*",
            "http://192.168.*.*/*",
            "http://192.168.*:*",
            "http://192.168.*:*/*",
            "http://10.*.*.*:*",
            "http://10.*.*.*:*/*",
            "http://10.*:*",
            "http://10.*:*/*",
            "http://172.*.*.*:*",
            "http://172.*.*.*:*/*",
            "http://172.*:*",
            "http://172.*:*/*",
            "http://localhost:*",
            "http://localhost:*/*",
            "http://127.0.0.1:*",
            "http://127.0.0.1:*/*"
        ]
    },
    "permissions": [
        "core:default",
        "core:window:allow-set-focus",
        "core:window:allow-show",
        "core:window:allow-hide",
        "core:window:allow-close",
        "core:window:allow-minimize",
        "core:window:allow-unminimize",
        "core:window:allow-maximize",
        "core:window:allow-unmaximize",
        "core:window:allow-is-minimized",
        "core:window:allow-is-maximized",
        "core:window:allow-is-visible",
        "core:window:allow-destroy",
        "core:window:allow-request-user-attention",
        "core:webview:allow-set-webview-zoom",
        "opener:default",
        "dialog:default",
        "process:default",
        "allow-all-app-commands",
        "allow-save-download-bytes",
        "allow-filesystem-commands",
        "allow-printer-commands",
        "allow-system-commands",
        "allow-window-commands",
        "allow-services-commands"
    ]
}
