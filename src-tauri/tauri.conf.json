{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nilkanth Medico - HOMS Child",
  "version": "0.0.1",
  "identifier": "nilkanth-medico-homs-child.com",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http: https: data: blob:; connect-src 'self' http: https: ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "../logo.ico",
      "../logo.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../logo.ico",
        "headerImage": null,
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
